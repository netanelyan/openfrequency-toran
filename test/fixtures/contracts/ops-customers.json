                "products": [
                  "teder"
                ],
                "people": 2,
                "invitesWaiting": 1,
                "lastLoginAt": "2026-10-23T18:00:00.000Z",
                "subscriptions": [
                  {
                    "product": "teder",
                    "plan": "small",
                    "monthly": 490,
                    "vat": "excluded",
                    "setup": 990,
                    "startedOn": "2026-10-01",
                    "paidUntil": "2026-10-31",
                    "endsOn": null,
                    "cancelledAt": null,
                    "comp": false,
                    "state": "paid",
                    "nextChargeOn": "2026-11-01"
                  }
                ],
                "invoices": {

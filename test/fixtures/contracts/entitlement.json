{
  "name": "entitlement",
  "doc": "docs/setup.md, \"GET /internal/entitlement\"",
  "servedBy": [
    "accounts"
  ],
  "calledBy": [
    "teder",
    "toran"
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/internal/entitlement",
      "listener": "127.0.0.1:4741 (accounts' internal listener: loopback socket and Host only, never proxied)",
      "auth": "Authorization: Bearer <OF_INTERNAL_TOKEN> (32 characters or more)",
      "request": {
        "query": {
          "workspace": "a positive integer",
          "product": "teder | toran"
        }
      },
      "notes": "Decide on `allowed` alone; `access` says why. `access` is one of paid, comp, due, unpaid, cancelled, off: a reader must accept every one of them (due is new on 2026-10-29). `plan` is in every 200 answer: Teder's is { name: full | small, slideshows, redos }, Toran's { name: store | big, conversations } (Toran's since 2026-11-08; a reader must accept a plan it does not know). `monthlyIls` is in every 200 answer since 2026-11-11: what a month of the product costs this workspace before VAT, in shekels to the agora, the base a product weighs what it spends on the workspace against (Teder: its AI cost, 30% alerts the operator and 50% stops the AI until the next month). It is the subscription's price, with the VAT taken out when it was recorded with it included, or the plan's list price when the product is complimentary or no price above 0 is recorded; a reader must accept an answer without it (an older accounts) and take the plan's list price then. The instants are the ends of Israel days, in UTC.",
      "answers": [
        {
          "case": "paid (Teder, the small plan)",
          "status": 200,
          "body": {
            "workspace": 7,
            "product": "teder",
            "enabled": true,
            "access": "paid",
            "allowed": true,
            "paidThrough": "2026-11-21T21:59:59.999Z",
            "cancelAt": null,
            "graceUntil": null,
            "plan": {
              "name": "small",
              "slideshows": 15,
              "redos": 4
            },
            "monthlyIls": 490
          },
          "nullable": [
            "paidThrough",
            "cancelAt",
            "graceUntil"
          ]
        },
        {
          "case": "due: the paid period is over, in its 72 hours of grace",
          "status": 200,
          "body": {
            "workspace": 7,
            "product": "teder",
            "enabled": true,
            "access": "due",
            "allowed": true,
            "paidThrough": "2026-11-21T21:59:59.999Z",
            "cancelAt": null,
            "graceUntil": "2026-11-24T21:59:59.999Z",
            "plan": {
              "name": "full",
              "slideshows": 40,
              "redos": 10
            },
            "monthlyIls": 790
          },
          "nullable": [
            "paidThrough",
            "cancelAt",
            "graceUntil"
          ]
        },
        {
          "case": "unpaid: never paid, or the grace is over",
          "status": 200,
          "body": {
            "workspace": 7,
            "product": "teder",
            "enabled": true,
            "access": "unpaid",
            "allowed": false,
            "paidThrough": null,
            "cancelAt": null,
            "graceUntil": null,
            "plan": {
              "name": "full",
              "slideshows": 40,
              "redos": 10
            },
            "monthlyIls": 790
          },
          "nullable": [
            "paidThrough",
            "cancelAt",
            "graceUntil"
          ]
        },
        {
          "case": "cancelled, working until its last day",
          "status": 200,
          "body": {
            "workspace": 7,
            "product": "teder",
            "enabled": true,
            "access": "cancelled",
            "allowed": true,
            "paidThrough": "2026-11-21T21:59:59.999Z",
            "cancelAt": "2026-11-21T21:59:59.999Z",
            "graceUntil": null,
            "plan": {
              "name": "full",
              "slideshows": 40,
              "redos": 10
            },
            "monthlyIls": 790
          },
          "nullable": [
            "paidThrough",
            "cancelAt",
            "graceUntil"
          ]
        },
        {
          "case": "complimentary",
          "status": 200,
          "body": {
            "workspace": 7,
            "product": "teder",
            "enabled": true,
            "access": "comp",
            "allowed": true,
            "paidThrough": null,
            "cancelAt": null,
            "graceUntil": null,
            "plan": {
              "name": "full",
              "slideshows": 40,
              "redos": 10
            },
            "monthlyIls": 790
          },
          "nullable": [
            "paidThrough",
            "cancelAt",
            "graceUntil"
          ]
        },
        {
          "case": "paid, a price agreed with VAT included: monthlyIls is the price before VAT (590 ₪ with VAT, 500 before it)",
          "status": 200,
          "body": {
            "workspace": 7,
            "product": "teder",
            "enabled": true,
            "access": "paid",
            "allowed": true,
            "paidThrough": "2026-11-21T21:59:59.999Z",
            "cancelAt": null,
            "graceUntil": null,
            "plan": {
              "name": "small",
              "slideshows": 15,
              "redos": 4
            },
            "monthlyIls": 500
          },
          "nullable": [
            "paidThrough",
            "cancelAt",
            "graceUntil"
          ]
        },
        {
          "case": "paid (Toran, the big plan)",
          "status": 200,
          "body": {
            "workspace": 7,
            "product": "toran",
            "enabled": true,
            "access": "paid",
            "allowed": true,
            "paidThrough": "2026-11-21T21:59:59.999Z",
            "cancelAt": null,
            "graceUntil": null,
            "plan": {
              "name": "big",
              "conversations": 1500
            },
            "monthlyIls": 1190
          },
          "nullable": [
            "paidThrough",
            "cancelAt",
            "graceUntil"
          ]
        },
        {
          "case": "off (Toran, its plan as a new subscription would start)",
          "status": 200,
          "body": {
            "workspace": 7,
            "product": "toran",
            "enabled": false,
            "access": "off",
            "allowed": false,
            "paidThrough": null,
            "cancelAt": null,
            "graceUntil": null,
            "plan": {
              "name": "store",
              "conversations": 300
            },
            "monthlyIls": 590
          },
          "nullable": [
            "paidThrough",
            "cancelAt",
            "graceUntil"
          ]
        },
        {
          "case": "the workspace is not a positive integer",
          "status": 400,
          "body": {
            "error": "bad_workspace"
          }
        },
        {
          "case": "a missing or unknown product",
          "status": 400,
          "body": {
            "error": "bad_product"
          }
        },
        {
          "case": "an id we never had (a deleted one is 200, off)",
          "status": 404,
          "body": {
            "error": "no_workspace"
          }
        },
        {
          "case": "no token, or the wrong one",
          "status": 401,
          "body": {
            "error": "bad_token"
          }
        },
        {
          "case": "OF_INTERNAL_TOKEN unset or short here",
          "status": 503,
          "body": {
            "error": "not_configured"
          }
        }
      ]
    }
  ]
}

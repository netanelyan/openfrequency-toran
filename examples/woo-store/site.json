{
  "about": "תבלינים בשוק, a fictional WooCommerce store. The Store API files are real responses recorded from Israeli WooCommerce stores, every key and shape kept, every name, address and price the fictional store's own (2026-10-24).",
  "host": "tavlinim-ba-shuk.example",
  "routes": {
    "/": { "file": "home.html", "headers": { "link": "<https://tavlinim-ba-shuk.example/wp-json/>; rel=\"https://api.w.org/\"" } },

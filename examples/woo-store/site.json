    "/wp-json/wc/store/v1/products?per_page=100&page=1": { "file": "store-api-products.json", "headers": { "x-wp-total": "6", "x-wp-totalpages": "1" } },
    "/wp-json/wc/store/v1/products?per_page=100&page=1&type=variation": { "file": "store-api-variations.json", "headers": { "x-wp-total": "5", "x-wp-totalpages": "1" } },
    "/wp-sitemap.xml": { "type": "application/xml; charset=UTF-8", "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<sitemapindex xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><sitemap><loc>https://tavlinim-ba-shuk.example/wp-sitemap-posts-page-1.xml</loc></sitemap><sitemap><loc>https://tavlinim-ba-shuk.example/wp-sitemap-posts-product-1.xml</loc></sitemap><sitemap><loc>https://tavlinim-ba-shuk.example/wp-sitemap-taxonomies-product_cat-1.xml</loc></sitemap></sitemapindex>\n" },
    "/wp-sitemap-posts-page-1.xml": { "type": "application/xml; charset=UTF-8", "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>https://tavlinim-ba-shuk.example/</loc></url><url><loc>https://tavlinim-ba-shuk.example/shop/</loc></url><url><loc>https://tavlinim-ba-shuk.example/cart/</loc></url><url><loc>https://tavlinim-ba-shuk.example/my-account/</loc></url><url><loc>https://tavlinim-ba-shuk.example/%d7%a6%d7%95%d7%a8-%d7%a7%d7%a9%d7%a8/</loc></url><url><loc>https://tavlinim-ba-shuk.example/%d7%9e%d7%a9%d7%9c%d7%95%d7%97%d7%99%d7%9d/</loc></url><url><loc>https://tavlinim-ba-shuk.example/privacy-policy/</loc></url></urlset>\n" },
    "/משלוחים/": { "text": "<!doctype html><html lang=\"he-IL\" dir=\"rtl\"><head><title>משלוחים &#8211; תבלינים בשוק</title></head><body class=\"page-template-default page\"><a class=\"skip-link screen-reader-text\" href=\"#content\">דלג לתוכן</a><header class=\"site-header\"><nav><a href=\"/shop/\">חנות</a></nav></header><main id=\"main\" class=\"site-main\"><article class=\"page\"><h1 class=\"entry-title\">משלוחים</h1><div class=\"entry-content\"><p>שליח עד הבית בכל הארץ עולה 30 ₪, ובהזמנה מעל 200 ₪ המשלוח עלינו.</p><p>איסוף מנקודת חלוקה עולה 15 ₪. ההזמנה יוצאת מהדוכן תוך יום עסקים ומגיעה תוך 2 עד 4 ימי עסקים.</p><p>אפשר גם לאסוף מהדוכן בשוק בימים א' עד ה', בלי תשלום.</p></div></article></main><footer class=\"site-footer\">© 2026 תבלינים בשוק</footer></body></html>" },
    "/refund_returns/": { "text": "<!doctype html><html lang=\"he-IL\" dir=\"rtl\"><head><title>מדיניות החזרות &#8211; תבלינים בשוק</title></head><body class=\"page-template-default page\"><header class=\"site-header\">תפריט</header><main id=\"main\" class=\"site-main\"><article class=\"page\"><h1 class=\"entry-title\">מדיניות החזרות</h1><div class=\"entry-content\"><p>צנצנת סגורה אפשר להחזיר תוך 14 יום מהיום שקיבלתם אותה, ונחזיר את הכסף בניכוי דמי המשלוח.</p><p>צנצנת שנפתחה לא מחזירים, כי זה מזון. אם הגיעה צנצנת שבורה, שלחו לנו תמונה בוואטסאפ ונשלח חדשה.</p></div></article></main><footer class=\"site-footer\">© 2026 תבלינים בשוק</footer></body></html>" },
    "/שאלות-נפוצות/": { "text": "<!doctype html><html lang=\"he-IL\" dir=\"rtl\"><head><title>שאלות נפוצות &#8211; תבלינים בשוק</title></head><body class=\"page-template-default page\"><header class=\"site-header\">תפריט</header><main id=\"main\" class=\"site-main\"><article class=\"page\"><h1 class=\"entry-title\">שאלות נפוצות</h1><div class=\"entry-content\"><details><summary>כמה זמן התבלינים נשארים טריים?</summary><p>בצנצנת סגורה, במקום יבש וחשוך, בערך חצי שנה.</p></details><details><summary>אפשר לשלם בביט?</summary><p>כן, בביט, באשראי ובפייפאל.</p></details></div></article></main><footer class=\"site-footer\">© 2026 תבלינים בשוק</footer></body></html>" },
    "/צור-קשר/": { "text": "<!doctype html><html lang=\"he-IL\" dir=\"rtl\"><head><title>צור קשר &#8211; תבלינים בשוק</title></head><body class=\"page-template-default page\"><header class=\"site-header\">תפריט</header><main id=\"main\" class=\"site-main\"><article class=\"page\"><h1 class=\"entry-title\">צור קשר</h1><div class=\"entry-content\"><p>הדוכן פתוח בימים א' עד ה' בין 8:00 ל־15:00, ובימי ו' עד 13:00.</p><p>אפשר לכתוב לנו בוואטסאפ או למייל shalom@tavlinim-ba-shuk.example, ואנחנו עונים באותו יום.</p></div></article></main><footer class=\"site-footer\">© 2026 תבלינים בשוק</footer></body></html>" }
  }

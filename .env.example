# Toran's settings. Copy to private/.env (npm run init-private does it) and fill in there.
# This file is public: every value here stays empty. check:public refuses a value.

# ---- where and how it runs
# dev (default, a laptop: the agent runs on the Claude Code CLI subscription) or prod (the VPS: the API)
TORAN_ENV=
# the private folder; default ./private
TORAN_HOME=
# force a model backend: claude-cli | api | scripted
TORAN_LLM=
# the Claude Code CLI binary, when it is not on PATH
TORAN_CLAUDE_BIN=
# where the embedding model is cached (keep it short on Windows)
TORAN_MODELS_DIR=
# the agent's model; default claude-sonnet-5-5
TORAN_MODEL_AGENT=
# monthly spend cap for paid API calls, in USD (past it the agent hands every chat to the owner without a model call)
TORAN_MONTHLY_CAP_USD=
# off: no embeddings (policies matched by words). Default on: multilingual-e5-small, local
TORAN_EMBED=
# Claude Code CLI calls at once (development), and a call's timeout in ms
TORAN_CLI_CONCURRENCY=
TORAN_CLI_TIMEOUT_MS=

# ---- who signs the pitch pages and the outreach messages
TORAN_OWNER_NAME=
# your own WhatsApp, digits only: shown on pitch pages; testing a demo from it never moves a lead's status
TORAN_OWNER_WHATSAPP=
TORAN_OWNER_EMAIL=

# ---- database: Postgres with pgvector in production. Empty: PGlite inside private/data
DATABASE_URL=

# ---- the agent in production
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# ---- lead discovery
BRAVE_API_KEY=

# ---- the WhatsApp demo number (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# the sender, e.g. +9725XXXXXXXX (or Twilio's sandbox number while testing)
TWILIO_WHATSAPP_FROM=
# the number the pitch page's button opens with wa.me, digits only
DEMO_WA_NUMBER=
# the public URL Twilio calls, for checking its signature: https://<host>/wa/twilio
TWILIO_WEBHOOK_URL=
# the owner line (docs/owner-line.md): business owners talk to their assistant here, and Teder's news reaches them
# from here. Digits only, a second number on the same Twilio account, its webhook the same /wa/twilio. The same value
# as OF_ASSISTANT_WA in openfrequency-accounts
TORAN_ASSISTANT_WA=
# our own support on WhatsApp (docs/company.md): the domain of a company store (npm run company -- sync), e.g.
# openfrequency.co.il. On the owner line, a number no account linked gets that store's agent instead of "this number
# is not linked"; on the demo number (our public number too), a phone with no demo gets it instead of "press the button
# on the page". Empty: off
TORAN_SUPPORT_STORE=
# the approved WhatsApp templates (src/owners/templates.ts, docs/whatsapp-templates.md), each name=its Twilio Content
# SID: teder_posts_ready=HX...,teder_post_reminder=HX...
TWILIO_TEMPLATES=
# sim forces the WhatsApp simulator even when the Twilio keys are set
TORAN_WA=

# ---- more channels (src/channels/): the code of each one listed is on. whatsapp is always on. e.g. whatsapp,email
TORAN_CHANNELS=
# Resend: replies by email, the emails that arrive (its webhook /mail/resend, signed with the whsec_ secret), their
# attachments, and the stores' own domains (its domains API): the key needs full access
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# the domain whose MX points at Resend; each store gets <slug>@ this domain, e.g. in.openfrequency.co.il
TORAN_MAIL_DOMAIN=
# Meta, directly (src/channels/meta.ts): a store connects its own WhatsApp Business app number (coexistence) through
# Embedded Signup. The webhook is /meta/webhook. docs/connecting-channels.md has the setup.
META_APP_ID=
META_APP_SECRET=
# the Embedded Signup configuration (Facebook Login for Business) made for WhatsApp, with WhatsApp Business app onboarding
META_WA_CONFIG_ID=
# any string you choose, the same here and in the app's webhook settings
META_WEBHOOK_VERIFY_TOKEN=
# Messenger and Instagram (src/channels/social.ts), through the same app, once TORAN_CHANNELS lists them. Meta sends
# the store back to PUBLIC_BASE_URL/meta/oauth/messenger and /meta/oauth/instagram: add both to the app's valid
# OAuth redirect URIs. Messenger: the Facebook Login for Business configuration made for it (empty: the login asks
# for the permissions itself)
META_FB_CONFIG_ID=
# Instagram: the Instagram app's id and secret (the app's Instagram, "API setup with Instagram login")
META_IG_APP_ID=
META_IG_APP_SECRET=
# 1 once Meta approved Human Agent: the store's own answers on Messenger and Instagram go out up to 7 days after the
# customer's last message, tagged HUMAN_AGENT. The agent never answers past 24 hours
META_HUMAN_AGENT=
# default v23.0
META_GRAPH_VERSION=
# 32+ random characters: seals each store's Meta token in the database. Without it nothing can be connected; change
# it and every connected number has to connect again
TORAN_SECRETS_KEY=

# ---- the website
# the public base of pitch pages, e.g. https://toran.example
PUBLIC_BASE_URL=
# the dashboard's host name behind Caddy
PUBLIC_HOST=
PORT=
# the address to listen on: 127.0.0.1 (default) behind a local proxy, 0.0.0.0 in a container
TORAN_LISTEN=
# 1 when the proxy is not on this machine (a container): trust its X-Forwarded-* headers
TORAN_TRUST_PROXY=
# 1 to accept any Host header (local development only)
TORAN_ANY_HOST=
# signs the CSRF token on every dashboard form (derived from the accounts session id)
SESSION_SECRET=

# ---- sign-in: openfrequency-accounts (its docs/internal-session.md). Toran has no login of its own.
# the same value as in openfrequency-accounts' private/.env, 32 characters or more. Unset: nobody can sign in
OF_INTERNAL_TOKEN=
# accounts' public address (the login and sign-out pages); default https://accounts.openfrequency.co.il
OF_ACCOUNTS_URL=
# accounts' internal address on this machine; default http://127.0.0.1:4741
OF_ACCOUNTS_INTERNAL=

# ---- Teder, for the owner line (docs/owner-line.md section 2)
# signs every request between Toran and Teder, 32 characters or more, the same value in Teder's .env. Unset: no
# Teder on the owner line, and Teder's events are refused
OF_ASSISTANT_SECRET=
# Teder's internal address on this machine; default http://127.0.0.1:4701
TEDER_INTERNAL=
# Teder's site on this machine, for the operator's dashboard (its GET /internal/demos, docs/operator.md); default
# http://127.0.0.1:4700
TEDER_SITE_INTERNAL=

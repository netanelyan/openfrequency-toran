# Toran's settings. Copy to private/.env (npm run init-private does it) and fill in there.
# This file is public: every value here stays empty. check:public refuses a value.

# ---- where and how it runs
# dev (default, a laptop: the agent runs on the Claude Code CLI subscription) or prod (the VPS: the API)
TORAN_ENV=
# the private folder; default ./private
TORAN_HOME=
# force a model backend: claude-cli | api | scripted
TORAN_LLM=
# the Claude Code CLI binary, when it is not on PATH
TORAN_CLAUDE_BIN=
# where the embedding model is cached (keep it short on Windows)
TORAN_MODELS_DIR=
# the agent's model; default claude-sonnet-5-5
TORAN_MODEL_AGENT=
# monthly spend cap for paid API calls, in USD (past it the agent hands every chat to the owner without a model call)
TORAN_MONTHLY_CAP_USD=
# each store's own monthly cap is its plan's conversations, twice, at this many USD each (default 0.25, measured in
# docs/milestones.md); a store's config.capUsd, set by the operator, replaces it (src/agent/spend.ts)
TORAN_CAP_USD_PER_CONVERSATION=
# the operator hears when one store spends more than this in an hour (default 5)
TORAN_STORE_HOUR_ALERT_USD=
# past this many answers in one hour at one store (default 200), or this many new email senders (default 30), new
# messages wait for the owner (src/channels/store.ts)
TORAN_STORE_TURNS_PER_HOUR=
TORAN_NEW_SENDERS_PER_HOUR=
# a customer is waiting: one agent turn has this long, in ms (default 60000), then the holding line and a handoff
TORAN_TURN_DEADLINE_MS=
# the worker's loops: for customers' messages only (default 2), and for everything else (default 1)
TORAN_MESSAGE_LOOPS=
TORAN_BACKGROUND_LOOPS=
# what tells the operator (src/ops/alert.ts, docs/operator.md section 6): every alert is in the log. Beside it, a
# command run as <cmd> "<title>" "<body>"; empty: /usr/local/bin/of-alert when it exists, else none; off: none
TORAN_ALERT_CMD=
# and the operator's own WhatsApp number, in any spelling (050-000-0123, +972500000123): each alert, Toran's and the
# ones Teder hands over at /internal/ops/alert, is one approved template message (operator_alert,
# docs/whatsapp-templates.md) from our number on Meta (META_DEMO_PHONE_ID or our one number, META_SYSTEM_TOKEN). The
# same alert at most once an hour, none for an hour after Meta refuses one (before the template is approved), at most
# 10 an hour. Empty: no WhatsApp
TORAN_ALERT_WA=
# on: the reply guard asks the model about a borderline claim it would cut (a fact the tools mention, not in a way
# code confirms), at most three a reply, each one call. Default off: the claim check is word lists only
TORAN_GUARD_LLM=
# off: no embeddings (policies matched by words). Default on: multilingual-e5-small, local
TORAN_EMBED=
# Claude Code CLI calls at once (development), and a call's timeout in ms
TORAN_CLI_CONCURRENCY=
TORAN_CLI_TIMEOUT_MS=

# ---- who signs the pitch pages and the outreach messages
TORAN_OWNER_NAME=
# your own WhatsApp, digits only: shown on pitch pages; testing a demo from it never moves a lead's status
TORAN_OWNER_WHATSAPP=
TORAN_OWNER_EMAIL=

# ---- database: Postgres with pgvector in production. Empty: PGlite inside private/data
DATABASE_URL=
# check: the server applies no migration and starts only on a schema already up to date (the deploy applies them,
# deploy/deploy.sh). Empty: applied at start (a laptop, the tests)
TORAN_MIGRATE=
# where the backups are, for the migrate step's "a backup under an hour old"; default /var/backups/toran
TORAN_BACKUP_DIR=
# set by deploy/deploy.sh to the time of the backup it took and checked, when the backups folder is not readable
TORAN_BACKUP_TAKEN_AT=
# the build's commit for /healthz and /readyz; default the REVISION file a deploy writes into each release
TORAN_REVISION=
# tests only: a Postgres 17 with pgvector to run the suite on instead of PGlite (each test gets its own database)
TORAN_TEST_DATABASE_URL=

# ---- the agent in production
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# ---- lead discovery
BRAVE_API_KEY=

# ---- the WhatsApp demo number (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# the sender, e.g. +9725XXXXXXXX (or Twilio's sandbox number while testing)
TWILIO_WHATSAPP_FROM=
# the number the pitch page's button opens with wa.me, digits only
DEMO_WA_NUMBER=
# the public URL Twilio calls, for checking its signature: https://<host>/wa/twilio
TWILIO_WEBHOOK_URL=
# the owner line (docs/owner-line.md): business owners talk to their assistant here, and Teder's news reaches them
# from here. Digits only, a second number on the same Twilio account, its webhook the same /wa/twilio, or on Meta
# (META_OWNER_PHONE_ID below). The same value as OF_ASSISTANT_WA in openfrequency-accounts
TORAN_ASSISTANT_WA=
# our own support on WhatsApp (docs/company.md): the domain of a company store (npm run company -- sync), e.g.
# openfrequency.co.il. On the owner line, a number no account linked gets that store's agent instead of "this number
# is not linked"; on the demo number (our public number too), a phone with no demo gets it instead of "press the button
# on the page". Empty: off
TORAN_SUPPORT_STORE=
# our support re-reads the website by itself (docs/company.md): the export the site's real build publishes,
# https://openfrequency.co.il/support.json. Read once an Israel day and soon after each start, and synced into the
# company store it names only when its content changed; the store must exist (the first sync is by hand), and with
# TORAN_SUPPORT_STORE set the export must be for that domain. A failed read is one log line, and the store keeps what
# it had. Empty: off, sync by hand (npm run company -- sync <file>)
TORAN_SUPPORT_EXPORT_URL=
# the approved WhatsApp templates (src/owners/templates.ts, docs/whatsapp-templates.md), each name=its Twilio Content
# SID: teder_posts_ready=HX...,teder_post_reminder=HX...
TWILIO_TEMPLATES=
# sim forces the WhatsApp simulator even when the Twilio keys are set
TORAN_WA=

# ---- more channels (src/channels/): the code of each one listed is on. whatsapp is always on. e.g. whatsapp,email
TORAN_CHANNELS=
# Resend: replies by email, the emails that arrive (its webhook /mail/resend, signed with the whsec_ secret), their
# attachments, and the stores' own domains (its domains API): the key needs full access
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# the domain whose MX points at Resend; each store gets <slug>@ this domain, e.g. in.openfrequency.co.il
TORAN_MAIL_DOMAIN=
# Meta, directly (src/channels/meta.ts): a store connects its own WhatsApp Business app number (coexistence) through
# Embedded Signup. The webhook is /meta/webhook. docs/connecting-channels.md has the setup.
META_APP_ID=
META_APP_SECRET=
# the Embedded Signup configuration (Facebook Login for Business) made for WhatsApp, with WhatsApp Business app onboarding
META_WA_CONFIG_ID=
# any string you choose, the same here and in the app's webhook settings
META_WEBHOOK_VERIFY_TOKEN=
# Messenger and Instagram (src/channels/social.ts), through the same app, once TORAN_CHANNELS lists them. Meta sends
# the store back to PUBLIC_BASE_URL/meta/oauth/messenger and /meta/oauth/instagram: add both to the app's valid
# OAuth redirect URIs. Messenger: the Facebook Login for Business configuration made for it (empty: the login asks
# for the permissions itself)
META_FB_CONFIG_ID=
# Instagram: the Instagram app's id and secret (the app's Instagram, "API setup with Instagram login")
META_IG_APP_ID=
META_IG_APP_SECRET=
# 1 once Meta approved Human Agent: the store's own answers on Messenger and Instagram go out up to 7 days after the
# customer's last message, tagged HUMAN_AGENT. The agent never answers past 24 hours
META_HUMAN_AGENT=
# default v23.0
META_GRAPH_VERSION=
# our own demo number and owner line on Meta's Cloud API instead of Twilio (src/channels/lines.ts): each one's phone
# number ID from WhatsApp Manager. Empty: that line stays on Twilio. The numbers they are known by are still
# DEMO_WA_NUMBER and TORAN_ASSISTANT_WA. docs/connecting-channels.md step 3 has the setup
# a store's own number through Kapso instead of our own Meta app (src/channels/kapso.ts, docs/connecting-channels.md
# "A store's number through Kapso"): kapso or meta (empty: meta); the project's API key; a secret we choose (16+
# characters) that Toran puts on each number's webhook to /kapso/webhook; the Platform webhook's secret as Kapso's
# dashboard made it (/kapso/events); who pays Meta for templates (empty: customer_managed, the store); Kapso's API
# (empty: https://api.kapso.ai). Our own number stays on Meta either way.
TORAN_WA_PROVIDER=
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_EVENTS_SECRET=
KAPSO_META_BILLING=
KAPSO_BASE_URL=
META_DEMO_PHONE_ID=
META_OWNER_PHONE_ID=
# optional: a system user's token of OpenFrequency's own business (Business Settings, System users), with our
# numbers' WhatsApp account assigned; it never expires. Empty: the token from connecting our number on the company
# store's WhatsApp page
META_SYSTEM_TOKEN=
# the pitches to leads (src/ops/outreach.ts, docs/whatsapp-templates.md "Pitches to leads"): the number they go out
# from when it is not the demo number (empty: the demo number), our WhatsApp account's id so each template's own status
# and quality are read before a send (2477118039396394 in production; empty: only the number's rating is read), and how
# many go a day, both products together (empty: 10)
META_OUTREACH_PHONE_ID=
META_WABA_ID=
TORAN_OUTREACH_DAILY=
# the owner line's templates Meta approved, by name: teder_posts_ready,teder_post_reminder,... (on Meta a template
# goes by its name; on Twilio by TWILIO_TEMPLATES' SID)
META_TEMPLATES=
# 32+ random characters: seals each store's Meta token in the database. Without it nothing can be connected; change
# it and every connected number has to connect again
TORAN_SECRETS_KEY=

# ---- the website
# the public base of pitch pages, e.g. https://toran.example
PUBLIC_BASE_URL=
# the dashboard's host name behind Caddy
PUBLIC_HOST=
PORT=
# the address to listen on: 127.0.0.1 (default) behind a local proxy, 0.0.0.0 in a container
TORAN_LISTEN=
# 1 when the proxy is not on this machine (a container): trust its X-Forwarded-* headers
TORAN_TRUST_PROXY=
# 1 to accept any Host header (local development only)
TORAN_ANY_HOST=
# signs the CSRF token on every dashboard form (derived from the accounts session id)
SESSION_SECRET=

# ---- sign-in: openfrequency-accounts (its docs/internal-session.md). Toran has no login of its own.
# the same value as in openfrequency-accounts' private/.env, 32 characters or more. Unset: nobody can sign in
OF_INTERNAL_TOKEN=
# accounts' public address (the login and sign-out pages); default https://accounts.openfrequency.co.il
OF_ACCOUNTS_URL=
# accounts' internal address on this machine; default http://127.0.0.1:4741
OF_ACCOUNTS_INTERNAL=

# ---- Teder, for the owner line (docs/owner-line.md section 2)
# signs every request between Toran and Teder, 32 characters or more, the same value in Teder's .env. Unset: no
# Teder on the owner line, and Teder's events are refused
OF_ASSISTANT_SECRET=
# Teder's internal address on this machine; default http://127.0.0.1:4700 (src/owners/teder.ts)
TEDER_INTERNAL=
# The website's lead service on this machine (openfrequency-web server/lead.mjs), for the operator's dashboard: its
# GET /internal/leads, the waitlist and the leads no product took (docs/operator.md); default http://127.0.0.1:4720
OF_WEB_INTERNAL=
# Teder's public address, where the operator's dashboard opens a Teder demo's page (/demos/<id>, docs/operator.md);
# default https://teder.openfrequency.co.il, the same value as accounts' TEDER_URL
TEDER_URL=
# Teder's site on this machine, for the operator's dashboard (its GET /internal/demos, docs/operator.md) and for a
# Teder demo asked for with a code on WhatsApp (its POST /internal/lead, src/channels/request.ts); default
# http://127.0.0.1:4700
TEDER_SITE_INTERNAL=

# ---- the headless browser (src/core/browser.ts), for stores whose pages JavaScript fills in
# Chromium's sandbox is on; 0 turns it off, only if the kernel refuses the toran user the namespaces it needs (a failed
# launch shows in the log as no rendered page; reading the raw HTML goes on either way)
TORAN_CHROMIUM_SANDBOX=
